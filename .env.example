# Prisma application connection (pooled connection may be used in hosted/serverless environments)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Prisma migration/direct connection. Keep this separate from DATABASE_URL when using a pooler.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Authentication provider configuration will be added in a later phase.
# PAYMENT and SHIPPING secrets must be server-only and must never be committed.
